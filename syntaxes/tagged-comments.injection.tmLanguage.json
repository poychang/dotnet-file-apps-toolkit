{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tagged comments in C#",
  "comment": "Highlights the body of /*<language> ... */ comments with the tagged language. The body uses a begin/while rule so a line containing */ always ends the embedded region, matching C# where the first */ closes the comment. Keep the tags in sync with src/comments/embeddedLanguageRegistry.ts (code-mode languages only).",
  "scopeName": "dotnetfileapps.tagged-comments.injection",
  "injectionSelector": "L:source.cs -comment -string",
  "patterns": [
    {
      "include": "#tagged-yaml"
    },
    {
      "include": "#tagged-json"
    },
    {
      "include": "#tagged-sql"
    },
    {
      "include": "#tagged-xml"
    },
    {
      "include": "#tagged-bash"
    },
    {
      "include": "#tagged-powershell"
    },
    {
      "include": "#tagged-csharp"
    },
    {
      "include": "#tagged-javascript"
    },
    {
      "include": "#tagged-typescript"
    },
    {
      "include": "#tagged-html"
    },
    {
      "include": "#tagged-css"
    },
    {
      "include": "#tagged-python"
    },
    {
      "include": "#tagged-cpp"
    },
    {
      "include": "#tagged-toml"
    },
    {
      "include": "#tagged-ini"
    },
    {
      "include": "#tagged-dockerfile"
    },
    {
      "include": "#tagged-csv"
    }
  ],
  "repository": {
    "tagged-yaml": {
      "name": "comment.block.tagged.yaml.cs",
      "begin": "(/\\*)((?i:yaml|yml))[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.cs"
        },
        "2": {
          "name": "keyword.other.language-tag.cs"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.cs"
        }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(?!.*\\*/)",
          "while": "(^|\\G)(?!.*\\*/)",
          "contentName": "meta.tagged-comment.content.yaml",
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        }
      ]
    },
    "tagged-json": {
